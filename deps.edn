{:paths ["src"]
 ;; langgraph-clj brings langchain-clj transitively (both zero-/single-dep,
 ;; all .cljc -> portable to JVM / SCI / ClojureScript / GraalVM). It lives
 ;; in the com-junkawasaki org of this workspace. This repo is standalone
 ;; (forkable outside the workspace); the :local/root paths only resolve
 ;; inside the monorepo checkout — a standalone fork should override them
 ;; with git coordinates.
 :deps {
        ;; kotoba.io replaced clojure.java.io / java.io.File here (2026-09-24).
        ;; An explicit floor: the java.io.File method functions (exists?, file?,
        ;; parent-file, canonical-path, mkdirs, list-files ...) are in kotoba.io
        ;; from this sha, and tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/io {:git/sha "1b60ca825c1e705bd195f857ca4549133653a9f3"}
        ;; kotoba.lang.edn replaced clojure.edn here (2026-09-23). An explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, and kbb resolves git deps
        ;; only from nbb.edn, so every project file this repo has names it.
        io.github.kotoba-lang/edn {:git/sha "79dba32c8892058842c57783f06a2dfe4601aeb0"}
       ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}
        ;; kotoba.robotics.process: the process-physics solvers and probe this
        ;; repo's physics.edn runs on (physical-AI bot, scripts/physical-ai-bots).
        io.github.kotoba-lang/robotics {:local/root "../../kotoba-lang/robotics"}

        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.com-junkawasaki/langgraph-clj
        {:local/root "../../kotoba-lang/langgraph"}
        ;; shared langchain.db store seam (EDN-blob codec + identity
        ;; schema + field-spec entity helpers) -- ADR-2607141600.
        io.github.kotoba-lang/langchain-store
        {:local/root "../../kotoba-lang/langchain-store"}}
 :aliases
 {
  ;; kbb -M:physics -> the physical-AI bot's measurement: runs physics.edn on
  ;; kotoba.robotics.process and prints one probe map. Exit 2 = could not measure.
  :physics {:main-opts ["-m" "kotoba.robotics.process.probe"]}
  ;; kbb -M:physai-test -> test/'s .cljk on kbb's runner (the bot's test count;
  ;; a .kotoba vertical's own :test may refuse kbb on purpose).
  ;; test/'s namespaces minus these, which cannot load on kbb (the full suite stays on :test, fleet JVM gate):
  ;; - pension.portable-cljs-test-runner: a cljs.main entry (*main-cli-fn*); its tests run here
  ;; - wasm.disbursement-entitlement-test: JVM-only by design (kototama.tender on the chicory wasm runtime)
  :physai-test {:extra-paths ["test" "test-physai"]
                :main-opts ["-m" "cognitect.test-runner"
                            "-n" "pension.physics-spec-test"
                            "-n" "pension.facts-test"
                            "-n" "pension.governor-contract-test"
                            "-n" "pension.kernels.gate-test"
                            "-n" "pension.phase-test"
                            "-n" "pension.registry-test"
                            "-n" "pension.store-contract-test"]}
;; This alias held an :override-deps entry for the retired coordinate
  ;; io.github.com-junkawasaki/langchain-clj. langgraph declares the same
  ;; library as io.github.kotoba-lang/langchain, so the entry matched no
  ;; node in the resolved tree and never reached the classpath -- verified
  ;; with `kbb -Stree`/-Spath, unchanged before and after removal.
  :dev {}
  ;; kbb -M:dev:run  -> drive the demo through one OperationActor
  :run {:main-opts ["-m" "pension.sim"]}
  ;; kbb -M:render-html [out-file] -> regenerate
  ;; docs/samples/operator-console.html by driving the REAL actor
  ;; (operation -> governor -> store) and projecting the store it
  ;; wrote. Flagship checklist item 2. jp-go-dds supplies the shared
  ;; cloud-itonami operator-console skin; it is git-coordinate (not
  ;; :local/root) so a standalone fork of this repo can still render.
  :render-html {:extra-deps {io.github.kotoba-lang/jp-go-digital-design-system
                             {:git/url "https://github.com/kotoba-lang/jp-go-digital-design-system"
                              :git/sha "83db99546eabc53613ae826ea41d1533a3c574af"}}
                :main-opts ["-m" "pension.render-html"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}
                      ;; kototama.tender hosts the wasm/disbursement_entitlement.kotoba
                      ;; build (see wasm/README.md) -- test-only, the actor's
                      ;; own runtime code has no wasm/host dependency.
                      io.github.kotoba-lang/kototama
                      {:local/root "../../kotoba-lang/kototama"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; PRIMARY gate: the same portable .cljc suite under a real
  ;; ClojureScript host (runtime priority: cljs first, JVM compat).
  ;;   kbb -Sdeps '{:paths ["src" "test"]}' -M:dev:cljs \
  ;;     -m cljs.main --target node -m pension.portable-cljs-test-runner
  :cljs {:extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}}}
  ;; static analysis -- clj-kondo from deps (no binary), errors fail CI.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
